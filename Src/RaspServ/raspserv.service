[Unit]
Description=RaspServ Modbus TCP and web dashboard
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/RaspServ/Src/RaspServ
ExecStart=/usr/bin/python3 /home/pi/RaspServ/Src/RaspServ/main.py
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
